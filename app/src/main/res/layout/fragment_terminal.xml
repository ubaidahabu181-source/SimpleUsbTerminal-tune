<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FF6D00"
        android:text="TARUNA TUNER V7.4"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:paddingStart="16dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#212121"
        android:text="DISCONNECTED"
        android:textColor="#FFEB3B"
        android:gravity="center"
        android:textSize="12sp" />

    <!-- 3 GAUGE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">

        <de.kai_morich.simple_usb_terminal.GaugeView
            android:id="@+id/rpmGauge"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_margin="4dp" />

        <de.kai_morich.simple_usb_terminal.GaugeView
            android:id="@+id/mapGauge"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_margin="4dp" />

        <de.kai_morich.simple_usb_terminal.GaugeView
            android:id="@+id/advGauge"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_margin="4dp" />
    </LinearLayout>

    <!-- DFCO -->
    <TextView
        android:id="@+id/dfcoLamp"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:background="#424242"
        android:text="DFCO OFF"
        android:textColor="#9E9E9E"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_margin="16dp" />

    <!-- BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnGetMap"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="GET MAP"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnSetMap"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="SET MAP"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnSaveTxt"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="SAVE TXT"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnLoadTxt"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="LOAD TXT"
            android:layout_margin="4dp" />
    </LinearLayout>

    <!-- HIDDEN OLD VIEWS FOR COMPATIBILITY -->
    <TextView android:id="@+id/receive_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/send_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/rpmValue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/mapValue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/advValue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content"/></ScrollView>

    <!-- GRID CONTAINER (HIDDEN AT START) -->
    <LinearLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#121212" />

</LinearLayout>
