<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <!-- PAGE 1 : 4 GAUGE 2x2 FULL -->
    <LinearLayout
        android:id="@+id/pageGauges"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0A0A0A">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="TARUNA TUNER V7.4 - RACE DASHBOARD"
            android:textColor="#00FFAA"
            android:textSize="13sp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:background="#111111"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:text="MAP INIT 5 - Matikan mesin lalu GET"
            android:textColor="#00FF88"
            android:textSize="10sp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:background="#1A1A1A"/>

        <!-- 2x2 GRID GAUGE FULL SCREEN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- ROW 1: RPM | MAP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="2">

                <de.kai_morich.simple_usb_terminal.GaugeView
                    android:id="@+id/gaugeRpm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:background="#111111"/>

                <de.kai_morich.simple_usb_terminal.GaugeView
                    android:id="@+id/gaugeMap"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:background="#111111"/>
            </LinearLayout>

            <!-- ROW 2: ADV (KLIK KE GRID) | DFCO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="2">

                <de.kai_morich.simple_usb_terminal.GaugeView
                    android:id="@+id/gaugeAdv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:background="#111111"/>

                <de.kai_morich.simple_usb_terminal.GaugeView
                    android:id="@+id/gaugeDfco"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:background="#111111"/>
            </LinearLayout>
        </LinearLayout>

        <!-- HIDDEN COMPAT VIEWS (needed for old logic, not visible) -->
        <TextView android:id="@+id/rpmValue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <TextView android:id="@+id/mapValue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <TextView android:id="@+id/advValue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <TextView android:id="@+id/dfcoLamp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <TextView android:id="@+id/limiterText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <TextView android:id="@+id/dfcoText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <android.widget.ProgressBar android:id="@+id/rpmBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <TextView android:id="@+id/receive_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <EditText android:id="@+id/send_text" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <Button android:id="@+id/send_btn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    </LinearLayout>

    <!-- PAGE 2 : GRID + LOG BLACKBOX + BACK -->
    <LinearLayout
        android:id="@+id/pageGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0E0E0E"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="#1A1A1A"
            android:gravity="center_vertical"
            android:padding="8dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:text="BACK"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/liveCellInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Live Cell: RPM 700 / MAP 20 kPa"
                android:textColor="#FFEB3B"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:padding="6dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnGet"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="GET"
                android:layout_marginEnd="4dp"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="SAVE TXT"
                android:layout_marginEnd="4dp"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnLoad"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="LOAD"
                android:textSize="12sp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/mapTableContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"/>
            </HorizontalScrollView>
        </ScrollView>

        <!-- BLACKBOX LOG AREA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="#1A1A1A"
            android:padding="6dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnLog"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="LOG BLACKBOX"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#FF9800"/>

            <Button
                android:id="@+id/btnShareLog"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="SHARE LOG"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="CLEAR LOG"
                android:textSize="11sp"/>

            <!-- Hidden logText for compat -->
            <TextView
                android:id="@+id/logText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
